# GitHub OAuth (노래책 CMS — /admin)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 노래책 CMS 비밀번호 (/admin 입장)
CMS_SONGS_PASSWORD=

# 노래방 아카이브 공개 CMS 토큰 (/archive-admin)
# Fine-grained PAT 필수: src/pages/Archive/archivedata/** write만 허용
# (이 토큰으로는 노래책 폴더 src/songlists/songs/ 수정 불가)
GITHUB_ARCHIVE_TOKEN=

# Production site URL (Vercel 배포 도메인)
# 예: https://haren-songbook.vercel.app
NEXT_PUBLIC_SITE_URL=
